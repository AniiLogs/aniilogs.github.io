# Public Discord application identifier.
DISCORD_CLIENT_ID=

# Keep these in Cloudflare secrets or .dev.vars. Never commit real values.
DISCORD_CLIENT_SECRET=
SESSION_SECRET=

# Private comma-separated Discord user IDs allowed to reveal developer diagnostics.
DEVELOPER_DISCORD_IDS=

# Private administrator bootstrap. These accounts can grant and revoke developer roles.
ADMIN_DISCORD_IDS=

# Exact browser origin allowed to exchange Discord handoffs and call the API.
PUBLIC_SITE_ORIGIN=http://127.0.0.1:8787
