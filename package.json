{
  "name": "aniilogs-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "node --check src/index.js && node --check public/app.js",
    "test": "node --test test/*.test.js",
    "db:migrate:local": "wrangler d1 migrations apply aniilogs-prod --local",
    "db:migrate:remote": "wrangler d1 migrations apply aniilogs-prod --remote"
  },
  "devDependencies": {
    "wrangler": "4.131.1"
  }
}

