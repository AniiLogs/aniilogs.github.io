{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aniilogs-api",
  "pages_build_output_dir": "./.pages-api-dist",
  "compatibility_date": "2026-09-14",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aniilogs-prod",
      "database_id": "48b12d6e-07c0-493d-90f9-e0a3b36ad176",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT",
      "bucket_name": "aniilogs-data-prod"
    }
  ],
  "vars": {
    "PUBLIC_SITE_ORIGIN": "https://aniilogs.github.io",
    "DISCORD_CLIENT_ID": "1548899251655020634",
    "CONTENT_RELEASE_ENABLED": "true"
  }
}
