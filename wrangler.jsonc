{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aniilogs-web",
  "main": "src/index.js",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aniilogs-prod",
      "database_id": "48b12d6e-07c0-493d-90f9-e0a3b36ad176",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}

