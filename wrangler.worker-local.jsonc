{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aniilogs-web-local",
  "main": "src/index.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aniilogs-prod",
      "database_id": "48b12d6e-07c0-493d-90f9-e0a3b36ad176",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_SITE_ORIGIN": "http://127.0.0.1:8787",
    "DISCORD_CLIENT_ID": "1548899251655020634"
  },
  "observability": {
    "enabled": true
  }
}
